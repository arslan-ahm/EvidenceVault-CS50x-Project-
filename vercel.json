{
  "buildCommand": "cd frontend && bun install && bun run build",
  "outputDirectory": "frontend/build",
  "installCommand": "echo skip-root-install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
