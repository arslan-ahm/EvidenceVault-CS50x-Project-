# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/evidencevault

# ── App / JWT auth ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Cookie auth ──────────────────────────────────────────────────────────────
COOKIE_NAME=evidencevault_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Frontend ──────────────────────────────────────────────────────────────────
# Local dev: FastAPI and SvelteKit run on different ports.
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000/api
# On Vercel, frontend + backend share one domain — use relative values instead:
#   FRONTEND_ORIGIN=https://your-project.vercel.app
#   PUBLIC_API_BASE_URL=/api

# ── Local uploads (fallback when MEGA is not configured) ─────────────────────
UPLOADS_DIR=uploads
# On Vercel the filesystem is read-only except /tmp — set UPLOADS_DIR=/tmp/uploads
MAX_UPLOAD_MB=25

# ── SMTP (welcome / password reset / change-password emails) ─────────────────
# Fill these in to enable outgoing email — leave SMTP_HOST empty to disable it
# (routes still work, emails are just skipped). Port 465 uses implicit TLS,
# port 587 uses STARTTLS (SMTP_USE_TLS=true) — most providers use 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=noreply@evidencevault.app
FRONTEND_RESET_URL=http://localhost:5173/reset-password

# ── Supabase (optional — alternative auth provider) ───────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ── MEGA (evidence/avatar storage) ────────────────────────────────────────────
# When both are set, uploads go to this MEGA account instead of local disk.
MEGA_UPLOADS_EMAIL=
MEGA_UPLOADS_PASSWORD=

# ── Cloudflare Turnstile (CAPTCHA on register/login) ──────────────────────────
# Leave both empty to skip CAPTCHA entirely (register/login work with no widget).
# Get a site key + secret key from the Cloudflare dashboard: Turnstile.
CLOUDFLARE_TURNSTILE_SECRET=
PUBLIC_TURNSTILE_SITE_KEY=
